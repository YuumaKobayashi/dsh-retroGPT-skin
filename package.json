{
  "name": "dsh-retrogpt-skin",
  "version": "0.7.4",
  "type": "module",
  "description": "RetroGPT skin for the DSH Web UI: the classic ChatGPT conversation layout (one column for both roles, retro marks, continuous turn bands, paper-plane send), a permanently dark sidebar, light/dark chat surfaces, a customisable own-avatar tile, a top-right theme switch, and a \"GPT retro UI\" settings page.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "skin",
    "retrogpt",
    "chatgpt"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "RELEASE-NOTES.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "check:privacy": "node tools/check-privacy.mjs",
    "prepack": "npm run check:privacy"
  }
}
